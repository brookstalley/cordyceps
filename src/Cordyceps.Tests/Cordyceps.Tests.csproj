<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- Run the net8.0 test host on a newer runtime when no .NET 8 runtime is installed.
         Only affects test execution; the shipping plugin (Cordyceps.csproj) stays net8.0. -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.6" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6" />
    <!-- Matches Cordyceps.csproj; required by linked Core files that use Newtonsoft.Json
         (McpResultFormatter.cs, UnifiedToolHelpers.cs). -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- JUnit XML output for the dotnet-test junit logger, consumed by
         `prawduct-hook test-evidence record` (the gate's evidence writer). -->
    <PackageReference Include="JunitXml.TestLogger" Version="8.0.0" />
  </ItemGroup>

  <!-- Link source files directly to avoid pulling in Grasshopper runtime dependencies -->
  <ItemGroup>
    <Compile Include="..\Cordyceps\Core\JsonTypeConverter.cs" Link="JsonTypeConverter.cs" />
    <Compile Include="..\Cordyceps\Core\ScriptDirective.cs" Link="ScriptDirective.cs" />
    <Compile Include="..\Cordyceps\Core\McpResultFormatter.cs" Link="McpResultFormatter.cs" />
    <Compile Include="..\Cordyceps\Core\RequestValidator.cs" Link="RequestValidator.cs" />
    <Compile Include="..\Cordyceps\Core\UnifiedToolHelpers.cs" Link="UnifiedToolHelpers.cs" />
  </ItemGroup>

</Project>
