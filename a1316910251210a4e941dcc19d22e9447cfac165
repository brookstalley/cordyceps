t.cs", "src/Cordyceps/Core/Edits/EditJournal.cs", "src/Cordyceps/Core/Edits/EditReplies.cs", "src/Cordyceps/Core/Edits/EditScope.cs", "src/Cordyceps/Core/Edits/EditTransaction.cs", "src/Cordyceps/Core/Edits/UndoEvents.cs", "src/Cordyceps/Core/GrasshopperContext.cs", "src/Cordyceps/Core/ScriptComponents.cs", "src/Cordyceps/Core/SliderConfig.cs", "src/Cordyceps/Core/SolutionWatcher.cs", "src/Cordyceps/Core/SolveCoordinator.cs", "src/Cordyceps/Core/SolvePolicy.cs", "src/Cordyceps/Core/SolveWait.cs", "src/Cordyceps/Core/SolverState.cs", "src/Cordyceps/Core/ToolHelpers.cs", "src/Cordyceps/Core/ValueListItems.cs", "src/Cordyceps/Core/WatchAdoption.cs", "src/Cordyceps/Knowledge/BestPracticesGuide.md", "src/Cordyceps/Knowledge/CommonErrorsGuide.md", "src/Cordyceps/Knowledge/DataTreesGuide.md", "src/Cordyceps/Knowledge/GettingStartedGuide.md", "src/Cordyceps/Knowledge/Prompts/CreateParametricGeometry.md", "src/Cordyceps/Knowledge/Prompts/PlanDefinition.md", "src/Cordyceps/McpServer.cs", "src/Cordyceps/Tools/Unified/GhCanvasTool.Groups.cs", "src/Cordyceps/Tools/Unified/GhCanvasTool.Modifiers.cs", "src/Cordyceps/Tools/Unified/GhCanvasTool.Values.cs", "src/Cordyceps/Tools/Unified/GhCanvasTool.Zoomable.cs", "src/Cordyceps/Tools/Unified/GhCanvasTool.cs", "src/Cordyceps/Tools/Unified/GhDocumentTool.cs", "src/Cordyceps/Tools/Unified/GhInspectTool.Tree.cs", "src/Cordyceps/Tools/Unified/GhScriptTool.cs", "src/Cordyceps/Tools/Unified/GhWireTool.cs"], "files_oracle": [".prawduct/artifacts/build-plan-edit-transaction.md", ".prawduct/artifacts/build-plan-solve-policy.md", ".prawduct/changes/edit-transaction.md", ".prawduct/changes/solve-policy.md", ".prawduct/operator-verification.md", ".prawduct/owner-rulings.md"], "findings": [{"goal": "Nothing Is Broken", "severity": "warning", "title": "No-op calls still push an undo record, contradicting 'undo absent when nothing changed'", "recommendation": "Scope: class. It broke because some bodies call a recorder unconditionally instead of only once a change is known, which is the pattern the last commit fixed for group_rename/colour/move. Known members: (1) GhCanvasTool.Groups.cs ActionGroupAdd on an existing group calls tx.RecordGeneric(group) unconditionally, so a group_add whose ids are all already members, with no new colour, returns `undo`. (2) GhScriptTool.cs ActionSet calls tx.RecordGeneric(component) before writing even when finalSource equals the stored source and the ports already match, so re-sending the same code returns `undo`. (3) GhScriptTool.cs ApplyConfigure records on both routes unconditionally, so configure with unchanged code, or with inputs/outputs whose names already match and no type/access change, returns `undo`. That contradicts configure's own ActionInfo tip ('A call that changes nothing records nothing and returns no undo'), the ApplyConfigure doc comment, and the server-instructions contract ('absent when nothing changed'). Consequences: an agent reads `undo` as 'the canvas changed', and the human's Ctrl+Z spends a step that reverts nothing. Fix: decide `unchanged` before the edit opens and record only when something differs, as set, config, modifier, move and rename already do. To find the rest of the class, search every `tx.Record*` call in src/Cordyceps/Tools/Unified/ that is not guarded by a change check.", "files": ["src/Cordyceps/Tools/Unified/GhCanvasTool.Groups.cs", "src/Cordyceps/Tools/Unified/GhScriptTool.cs"], "fid": "R-1"}, {"goal": "Nothing Is Unintended", "severity": "warning", "title": "Governing-artifact disposition says the contract changes additively; the diff carries several labelled breaking changes", "recommendation": "Governing-Artifact Reconciliation. The plan's Norm dispositions say 'project-preferences.md: conforms \u2026 Response shapes are kept and gain only an `undo` field' and 'boundary-patterns.md: the MCP action contract changes additively, plus the `delete` solve change (Inference 4)'. The diff does not match that. Replies gain `rolledBack`, `rollbackFailures` and `warning`. `configure` loses `sourceError` and changes what `codeSet:false` means. `gh_script set`'s failure reply drops `componentType`. Toggle `set` parsing, value-list `items`, slider plans, `set_count` and `configure` on a fixed-parameter component each change behaviour in a breaking way (7 'breaking:' items in the change fragment's consumer note). This is not BLOCKING. boundary-patterns.md forbids silent renames and removals; each of these is recorded in Decisions made mid-build, labelled 'Breaking' in CHANGELOG.md, and the owner ruled that this ships in the next major. What is wrong is the disposition itself: a reader of governed_by (the PR reviewer, the release step) would conclude the only break is delete's solve. Fix: restate the disposition so it is true of the diff. Either name the breaking response and behaviour changes and cite the owner's next-major ruling as the recorded decision, or make it relational by pointing at the fragment's consumer-note breaking list. Scope: instance.", "files": [".prawduct/artifacts/build-plan-edit-transaction.md"], "fid": "R-2"}, {"goal": "The Design Is Sound", "severity": "warning", "title": "'Changes nothing -> no undo' is hand-coded per call site in two idioms and still fails for group_add, gh_script set and configure", "recommendation": "Scope: class. The cause is that the journal records whatever it is told to, so each action has to decide for itself whether anything changed. Some actions check before the edit opens and return the reply outside `_context.Edit` (move, rename, delete, group_rename/colour/move, gh_document clear). Others open the edit and guard the recorder with an `unchanged`/`changes` flag (set, config, preview, enable, modifier, group_remove, wire connect/clear). The last commit (a131691) had to patch three missed sites. At least three still push an undo step that changes nothing. (1) `ActionGroupAdd` on an existing group calls `tx.RecordGeneric(group)` unconditionally, even when every id is already a member and no new colour is given. (2) `gh_script set` records unconditionally, even when the source is identical. (3) `ApplyConfigure` records on any passed side or code, even when it is identical. Yet McpServer `GetServerInstructions()`, GettingStartedGuide, CommonErrorsGuide, CHANGELOG and the gh_script `configure` tip ('A call that changes nothing records nothing and returns no undo') all promise that `undo` is absent when nothing changed. The consequence: an agent sees `undo` for a call that did nothing, and a human's Ctrl+Z is spent on an empty step. Close it by construction, not with a fourth per-site patch. Either have the host sink drop no-op actions at commit (compare each captured action's archived before-state with the object's current archive in `EditTransaction` before `Push`), so 'no change -> no record' holds for every current and future action. Or narrow the documented contract to the actions that check. Search for every `_context.Edit(` body whose `tx.Record*` call is not guarded by a current-vs-requested comparison.", "files": ["src/Cordyceps/Tools/Unified/GhCanvasTool.Groups.cs", "src/Cordyceps/Tools/Unified/GhScriptTool.cs", "src/Cordyceps/Core/Edits/EditTransaction.cs", "src/Cordyceps/McpServer.cs"], "fid": "R-3"}, {"goal": "The Design Is Sound", "severity": "warning", "title": "clear reconstructs 'solve scheduled' by re-parsing the edit's reply and inferring it from four field presences, though the transaction knows it", "recommendation": "Scope: instance. The cause is that `EditReplies.Committed` reports `solve` only for a refusal, so `SolvePolicy.WithScheduledEditSolve` re-parses the serialized reply. It then guesses 'scheduled' from success && undo && !solve && !warning, while `CommitOutcome.Scheduled` and `EditTransaction._scheduling` already hold the answer. The cost is real. A clear whose warning came from `restore` or `expire` (scheduling succeeded) is reported with no `solve`, so the agent is sent to check info and recompute for nothing. The inference is also coupled to `EditScope`/`EditReplies` field logic, so a change there (for example a `solve` on an expire-only commit) silently changes what clear reports. Any second non-waiting edit has to copy the pattern. Fix: let the scope emit `solve` from the source of truth. For example, an `Edit` option (or `IEditSession` member) that reports `_scheduling.ToField()` whenever `outcome.Scheduled`, scheduled or refused. Then delete `WithScheduledEditSolve` and its tests, and update the clear tip that says 'a reply with a warning has no solve'.", "files": ["src/Cordyceps/Core/SolvePolicy.cs", "src/Cordyceps/Core/Edits/EditScope.cs", "src/Cordyceps/Core/Edits/EditReplies.cs", "src/Cordyceps/Tools/Unified/GhDocumentTool.cs"], "fid": "R-4"}, {"goal": "Everything Is Coherent", "severity": "warning", "title": "CLAUDE.md and architecture.md say every document mutation goes through Edit; following that for the solver switch silently breaks it", "recommendation": "Scope: instance. Two docs overstate the rule. CLAUDE.md says '`_context.Edit(...)` for any document mutation', and docs/architecture.md says 'Reads use bare ExecuteOnUiThread; mutations never do'. Neither is true of `gh_document solver` (`doc.Enabled = enabled` in bare `ExecuteOnUiThread`) or `revert` (`canvas.Document = newDoc`). Both stay outside Edit by design, and the tool tips say so. The rule is also harmful if followed. `EditTransaction.BeginApply` saves `Document.Enabled`, and `EndApply` writes it back after the body, so a maintainer who 'brings solver into line' by wrapping it in `_context.Edit` gets a toggle that is silently reverted at commit. Fix: make both statements relational, so they cover changes to the document's objects, wires and values, and name document-level switches and document replacement as outside Edit. Optionally have `EditTransaction` throw if a body changed `Document.Enabled`, so the trap cannot be reached.", "files": ["CLAUDE.md", "docs/architecture.md", "src/Cordyceps/Core/Edits/EditTransaction.cs"], "fid": "R-5"}, {"goal": "The System Can Be Understood", "severity": "warning", "title": "A rollback's 'undo failed' dialog tells the agent to wait, while the guide says connection reports modal_inferred:true", "recommendation": "Scope: class. It broke because a rollback runs inside the edit's ExecuteOnUiThread, so SolverState's UI-work counter is above zero. A GH_GenericObjectAction restore that fails during rollback raises Grasshopper's modal Tracing.Assert on the UI thread. While that dialog is open, SolverState.Snapshot computes modalInferred = Blocked && !solving && !uiWorkInProgress, which is false. BuildHint then answers 'A Cordyceps operation is running on the Rhino UI thread ... This is our own work, not a stuck host ... Wait for it to finish', and the tool call itself stays blocked in InvokeAndWait until a human dismisses the dialog. Meanwhile CommonErrorsGuide.md's new row says that during a rollback 'connection shows modal_inferred:true'. That is true only of a human's Ctrl+Z, which runs outside the bracket. Consequence: an agent that meets this failure follows the probe, polls and waits, and never tells the user that a dialog needs dismissing. This is the same misreporting solve-policy removed for solver-exception dialogs. Learnings core, 'A signal is only as trustworthy as what the REST of the system does to it': enumerate every other path that moves the signal's inputs. The class is any modal Grasshopper or Rhino raises inside a Cordyceps UI call, not only this rollback, so fix it once in BuildHint's UiWorkInProgress case rather than per site: once the hold runs past a bound, add the solving case's 'if it persists, ask a human to check Rhino for an open dialog' clause. Then make the guide row describe what connection actually reports during a rollback.", "files": ["src/Cordyceps/Knowledge/CommonErrorsGuide.md", "src/Cordyceps/Core/SolverState.cs", "src/Cordyceps/Core/Edits/EditTransaction.cs"], "fid": "R-6"}, {"goal": "Decisions Were Deliberate", "severity": "warning", "title": "scope-trace: RecordPersistentData, its CreatePersistentDataEvent<T> reflection helper and tx.Expire have no production caller", "recommendation": "Scope: instance. It broke because Chunk 01 lifted Hyperceps' whole recorder set, while no migrated action writes a param's persistent data or needs an explicit expire. A grep of src/Cordyceps finds no caller of EditTransaction.RecordPersistentData or EditTransaction.Expire. So UndoEvents' PersistentDataEvent (a MakeGenericMethod/Invoke over GH_UndoUtil.CreatePersistentDataEvent<T>, plus the static Single() lookup that backs it) is reachable from nothing. Only the host-free journal's key handling is tested (EditJournalTests uses EditKind.PersistentData as a label), and VRF-024 has no step that could exercise it. Consequence: the first consumer, which the plan's Goals name as batch (#96), inherits a reflection path that no run has proven, sitting beside recorders that VRF-024 does verify, and nothing marks the difference. Either remove the unconsumed recorders (RecordPersistentData, the PersistentData kind's host case and helper, and tx.Expire) until a consumer arrives, or record in the plan's Decisions which consumer they were built for and that they ship unexercised.", "files": ["src/Cordyceps/Core/Edits/UndoEvents.cs", "src/Cordyceps/Core/Edits/EditTransaction.cs"], "fid": "R-7"}, {"goal": "Decisions Were Deliberate", "severity": "warning", "title": "The edit-transaction Inferences reach the boundary still unconfirmed, and several are breaking contract", "recommendation": "The edit-transaction plan's Goals label Inferences 1-6 and the `undo` field shape as 'made on the owner's behalf; the boundary review shows them to the owner'. This is that review, and owner-rulings.md records no confirmation of any of them: its transaction-wave entry covers only Windows, agent undo/redo and fragments. Several now ship as consumer contract. Inference 1: per-id actions commit their resolved ids as one step rather than all-or-nothing, which batch (#96) builds on. Inference 4: delete and group_delete schedule one solve and return before it runs, labelled breaking. Inference 6: an edit never waits for its solve. The norm-disposition inference: `\"undo\": \"<record name>\"`, absent when nothing changed. The solve-policy plan merged into this branch likewise carries Inferences 1-4 with no recorded confirmation. Consequence: once this merges, a later session reading the plan cannot tell whether these were the owner's choices or the builder's, and a reversal would then be another breaking change. Put the behaviour-visible inferences to the owner before the merge and record the answer in owner-rulings.md. Do not resolve this by editing the plan's labels.", "files": ["src/Cordyceps/Tools/Unified/GhCanvasTool.cs", "src/Cordyceps/Tools/Unified/GhCanvasTool.Groups.cs", "src/Cordyceps/Core/Edits/EditScope.cs", "CHANGELOG.md"], "fid": "R-8"}], "counts": {"blocking": 0, "warning": 8, "note": 0}, "observations": [{"goal": "Nothing Is Missing", "title": "Chunk 06 acceptance asks for the mutation-grep evidence in the record; none is recorded", "recommendation": "Chunk 06's acceptance criterion reads 'A grep for document mutations in the tool classes finds none outside a transaction (evidence in the record)'. Neither the plan's Decisions nor .prawduct/changes/edit-transaction.md records that grep or its result. A reviewer-side grep at a131691 (AddObject/RemoveObject/AddSource/RemoveSource/RemoveAllSources, NickName/Pivot/Locked/Hidden/Colour/UserText/Selected assignments, SetSliderValue, ListItems.Add/Clear, Params.Register/Unregister, CreateParameter, ExpireSolution/NewSolution/ScheduleSolution) found every tool-class mutation inside a `_context.Edit` body or on an object not yet added. The exceptions are the by-nature ones the plan names: solver's doc.Enabled, revert's canvas.Document, bake. So the criterion holds, and only its evidence is missing from the record. Scope: instance.", "oid": "O-1"}, {"goal": "Decisions Were Deliberate", "title": "Learnings Cross-Check: core.md's hand-ticked `## Status` rule describes a mechanism neither plan in this diff uses", "recommendation": "Read core.md, release.md and tests.md, the list from learnings-files --for-diff. Several rules applied and held. 'Validate-then-mutate, and never conflate unparseable with empty' fits the value-list items, the slider plan and configure's up-front refusal. 'A test naming a race/snapshot/ordering contract must actually exercise concurrency' fits SolveWaitTests, which use Task.Run waiters and never-completing TaskCompletionSources. 'Code linked into Cordyceps.Tests must stay host-free' holds for EditJournal, EditScope, EditReplies, SolvePolicy, SolveWait, ValueListItems and WatchAdoption, all without DebugLog. One rule is stale. 'Build-plan `## Status` boxes are hand-ticked ...' (and the chunk-heading rule's premise that verify-chunk-refs reads `## Status` lines) does not match this diff: build-plan-edit-transaction.md and build-plan-solve-policy.md are version-2 plans with no `## Status` section, and the current build-plan template says chunk state is computed (`prawduct-hook plan status`). Record-lint still graded chunks 02-06. Retire or merge that core rule so the next session does not hand-add a Status block the tooling no longer reads.", "oid": "O-2"}, {"goal": "Decisions Were Deliberate", "title": "Backlog Reconciliation: #91 and #95 are closed by the fragments; #116's slider half overlaps this branch", "recommendation": "Queried the backlog cache (synced 2026-11-11T17:05Z) with search 'undo' and affecting <the edited tool and core files>. The change fragments' closes: lines match the work: edit-transaction closes #91 and solve-policy closes #95. #73 (finish or formally cut undo/redo) is already dropped, consistent with the owner's ruling to keep agent undo/redo off. #96 (batch) and #60 (Rhino-side undo) stay open and are named as out of scope. #116 'gh-canvas: group and slider actions accept bad input silently' was filed at 18:50Z, minutes before this review. This branch's SliderConfig.Plan now refuses non-finite or out-of-range min/max/value, decimals above 8, min > max and a non-number value before any change. Check #116's slider half against that before the merge, so the item does not stay open for work this branch already did.", "files": ["src/Cordyceps/Core/SliderConfig.cs"], "oid": "O-3"}], "duration_seconds": 900, "scope": "edit-transaction", "scope_chosen_by": "binding", "scope_unresolved_cause": null, "scope_reason": null, "base_extended_from": null, "chunks": ["02", "03", "04", "05", "06"], "chunks_proposed": ["02", "03", "04", "05", "06"], "chunk": "02", "base_reviewed": "89c3f2c27aa86ca1f9fc8a46ff74beed80423a9f", "record_lint": {"records": [".prawduct/artifacts/build-plan-edit-transaction.md", ".prawduct/artifacts/build-plan-solve-policy.md", ".prawduct/changes/edit-transaction.md", ".prawduct/changes/solve-policy.md", ".prawduct/operator-verification.md", ".prawduct/owner-rulings.md", "CHANGELOG.md", "CLAUDE.md", "README.md", "docs/architecture.md", "src/Cordyceps/Knowledge/BestPracticesGuide.md", "src/Cordyceps/Knowledge/CommonErrorsGuide.md", "src/Cordyceps/Knowledge/DataTreesGuide.md", "src/Cordyceps/Knowledge/GettingStartedGuide.md", "src/Cordyceps/Knowledge/Prompts/CreateParametricGeometry.md", "src/Cordyceps/Knowledge/Prompts/PlanDefinition.md"], "chunk_graded": "02", "chunks_graded": ["02", "03", "04", "05", "06"], "plan_graded": ".prawduct/artifacts/build-plan-edit-transaction.md", "findings": [], "unchecked": [], "counts": {"chunk-ref-missing": 0, "governed-by-gap": 0, "suite-total-claim": 0, "learnings-over-budget": 0, "learnings-budget-unreasoned": 0, "learnings-core-raise-unapproved": 0, "learnings-rule-too-long": 0, "learnings-rule-body": 0, "learnings-area-dead": 0, "change-fragment": 0, "retired-claim-survives": 0}}, "dispatched_at": "2026-11-11T18:53:1