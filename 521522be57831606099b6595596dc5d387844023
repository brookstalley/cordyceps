md", "src/Cordyceps/McpServer.cs", "src/Cordyceps/Tools/Unified/GhCanvasTool.Groups.cs", "src/Cordyceps/Tools/Unified/GhCanvasTool.Modifiers.cs", "src/Cordyceps/Tools/Unified/GhCanvasTool.Values.cs", "src/Cordyceps/Tools/Unified/GhCanvasTool.Zoomable.cs", "src/Cordyceps/Tools/Unified/GhCanvasTool.cs", "src/Cordyceps/Tools/Unified/GhDocumentTool.cs", "src/Cordyceps/Tools/Unified/GhScriptTool.cs", "src/Cordyceps/Tools/Unified/GhWireTool.cs"], "files_changed": [".prawduct/artifacts/build-plan-edit-transaction.md", ".prawduct/changes/edit-transaction.md", ".prawduct/operator-verification.md", ".prawduct/owner-rulings.md", "CHANGELOG.md", "CLAUDE.md", "README.md", "docs/architecture.md", "src/Cordyceps.Tests/Cordyceps.Tests.csproj", "src/Cordyceps.Tests/EditFakes.cs", "src/Cordyceps.Tests/EditJournalTests.cs", "src/Cordyceps.Tests/EditRepliesTests.cs", "src/Cordyceps.Tests/EditScopeTests.cs", "src/Cordyceps.Tests/NoChangeTests.cs", "src/Cordyceps.Tests/SliderConfigTests.cs", "src/Cordyceps.Tests/SolvePolicyTests.cs", "src/Cordyceps.Tests/SolverStateTests.cs", "src/Cordyceps.Tests/ValueListItemsTests.cs", "src/Cordyceps/Core/Canvas/CanvasReader.cs", "src/Cordyceps/Core/Edits/EditJournal.cs", "src/Cordyceps/Core/Edits/EditReplies.cs", "src/Cordyceps/Core/Edits/EditScope.cs", "src/Cordyceps/Core/Edits/EditTransaction.cs", "src/Cordyceps/Core/Edits/UndoEvents.cs", "src/Cordyceps/Core/GrasshopperContext.cs", "src/Cordyceps/Core/NoChange.cs", "src/Cordyceps/Core/ScriptComponents.cs", "src/Cordyceps/Core/SliderConfig.cs", "src/Cordyceps/Core/SolvePolicy.cs", "src/Cordyceps/Core/SolverState.cs", "src/Cordyceps/Core/ToolHelpers.cs", "src/Cordyceps/Core/ValueListItems.cs", "src/Cordyceps/Knowledge/CommonErrorsGuide.md", "src/Cordyceps/Knowledge/GettingStartedGuide.md", "src/Cordyceps/McpServer.cs", "src/Cordyceps/Tools/Unified/GhCanvasTool.Groups.cs", "src/Cordyceps/Tools/Unified/GhCanvasTool.Modifiers.cs", "src/Cordyceps/Tools/Unified/GhCanvasTool.Values.cs", "src/Cordyceps/Tools/Unified/GhCanvasTool.Zoomable.cs", "src/Cordyceps/Tools/Unified/GhCanvasTool.cs", "src/Cordyceps/Tools/Unified/GhDocumentTool.cs", "src/Cordyceps/Tools/Unified/GhScriptTool.cs", "src/Cordyceps/Tools/Unified/GhWireTool.cs"], "files_oracle": [".prawduct/artifacts/build-plan-edit-transaction.md", ".prawduct/changes/edit-transaction.md", ".prawduct/operator-verification.md", ".prawduct/owner-rulings.md"], "findings": [{"goal": "Nothing Is Unintended", "severity": "blocking", "title": "group_move with a zero offset silently changes its reply shape: movedCount becomes 0, offset and bounds are removed (the boundary-patterns 'conforms' disposition is untrue here)", "recommendation": "Scope: instance. The coordinator's no-op short-circuit (commit a131691) replaced the old reply rather than keeping its shape. Before this branch, group_move with dx=dy=0 returned {success, groupId, movedCount: <members with attributes>, offset, bounds}. It now returns {success, groupId, movedCount: 0, message: 'Nothing to move: dx and dy are both 0'}. For an empty group the message also changes, from 'Group has no members'. boundary-patterns.md (governed_by) defines the MCP response shape as contract: 'never silent renames or removals'. The plan's Norm dispositions say 'none of these is silent', but this change is absent from CHANGELOG.md, from the plan's list of Breaking changes and from group_move's ActionInfo. That makes the change a departure from the norm with no recorded decision. Every other no-op short-circuit in this diff keeps its reply shape: group_rename, group_color, group_add, move, rename, connect, wire clear and set_count all do. Preferred fix: keep the old shape on the no-op path without opening an edit, so movedCount is the count of members with attributes, offset is {0,0} and bounds is read from the group. Otherwise label it Breaking in CHANGELOG.md and record it among the plan's Norm dispositions.", "files": ["src/Cordyceps/Tools/Unified/GhCanvasTool.Groups.cs", "CHANGELOG.md"], "fid": "R-1"}, {"goal": "Nothing Is Broken", "severity": "warning", "title": "group_add (and group_create) read an unparseable colour as 'no colour given'; on an existing group with every id already a member, the call is now answered as a successful no-op", "recommendation": "Scope: instance (two sites, GhCanvasTool.Groups.cs ActionGroupCreate and ActionGroupAdd). The colour parse merges 'not given' and 'invalid' into one false. The learnings rule 'Validate-then-mutate, and never conflate \"unparseable\" with \"empty\"' says a parse failure is an error, never an empty value. `bool colourGiven = ToolHelpers.TryParseColor(color, out var parsedColor)` is false both for an omitted colour and for an invalid one such as 'teal-ish'. This diff then passes `colourGiven ? argb : null` into NoChange.GroupAdd. As a result, group_add with an invalid colour and ids that are already members returns success:true with no undo and changes nothing, and the caller believes the colour was applied. group_create, and group_add on a new group or with new ids, also drop the colour silently under success:true. group_color already refuses the same input ('Invalid color: \u2026'). Fix: treat a non-empty `color` that does not parse as a refusal before the edit opens, at both sites, matching group_color. Add a NoChange/parse test, or move the decision into a host-free helper with a test.", "files": ["src/Cordyceps/Tools/Unified/GhCanvasTool.Groups.cs"], "fid": "R-2"}, {"goal": "Nothing Is Missing", "severity": "warning", "title": "No live-host evidence for any migrated family before merge: VRF-024 is pending, while every canvas-mutating action now relies on Grasshopper undo actions only ever read from decompiled source", "recommendation": "Scope: instance. The host-free rules are well tested (EditJournal/EditScope/EditReplies with a fake sink; test-status is current, 1390 passed). What has not been run on a live host is whether the real recorders undo cleanly without Grasshopper's modal 'undo failed' assert: GH_GenericObjectAction on sliders, value lists, groups, script and variable-parameter components; GH_DataModificationAction; remove/add actions with their wire actions. Undo-free rollback has not run there either. The change record lists only unit tests and a clean Release build, and the 2026-11-09 macOS spike exercised Hyperceps code, not this code. The goal applies here ('For user-visible changes: product verified beyond tests'). So does boundary-patterns.md's Test Levels row, which makes changes touching the live document 'Verified live in Rhino'. The plan rates its own confidence Medium, 'Raised by VRF-024'. A family whose generic restore fails would put a modal dialog in front of every user who presses Ctrl+Z, and the rollback cannot see that failure (per the plan's verify-api note). Recommendation: run VRF-024 on macOS before `scripts/release.sh prep` cuts the major that ships this, and record the result. If merging to develop ahead of it is intended, record that the release is gated on VRF-024.", "files": [".prawduct/operator-verification.md", "src/Cordyceps/Core/Edits/EditTransaction.cs", "src/Cordyceps/Core/Edits/UndoEvents.cs"], "fid": "R-3"}, {"goal": "The Design Is Sound", "severity": "warning", "title": "gh_script's 'changes nothing' answer copies the edit's logic instead of sharing it, so drift makes configure skip a real change", "recommendation": "Scope: class. Why it broke: NoChange.cs predicts what the gh_script edit would do by re-deriving it from the same inputs, rather than calling the code that does it. The copies: (1) NoChange.AccessOf ('list'/'tree', else 'item') copies the access switch in GhScriptTool.ApplyParamHints (GhScriptTool.cs ~L1002-1007), and neither calls the other. (2) NoChange.ScriptSourceSync parses the signature again with ScriptSignature.Parse and compares names with SequenceEqual, which is the inputsMatch/outputsMatch test SyncScriptParams already runs (with PortRemoval.ForSourceSync, that makes three parses of one sync). (3) NoChange.ScriptAlreadyAppliedReason is a second owner of the rebuild-skip reason, next to ScriptConfigurePlan.NothingChangedReason, whose own docstring says new ways to change a component belong there. NoChange's remark that it 'errs toward changes something' only holds while the copies agree. If they drift toward 'unchanged', ConfigureUnchangedReply answers success with parametersApplied:true and never applies the change, which is worse than a missing undo step. Instance fix: have ApplyParamHints map access through NoChange.AccessOf, or a shared ToGhAccess. Class fix: compute the script call's sync plan once, before the edit (signature targets through ParamSyncPlan, plus access), as SliderConfig.Plan already does for sliders. The no-change test then becomes 'the plan is empty', and SyncScriptParams and ApplyParamHints carry out the same plan. Search for other predictor and executor pairs: NoChange.*, PortRemoval.For*, and the Tools/ code each one mirrors.", "files": ["src/Cordyceps/Core/NoChange.cs", "src/Cordyceps/Tools/Unified/GhScriptTool.cs"], "fid": "R-4"}, {"goal": "The Design Is Sound", "severity": "warning", "title": "Only gh_document clear checks tx.RemoveObject's 'in this document' precondition up front; delete and group_delete reach it as a throw that rolls back the whole call", "recommendation": "Scope: class. Why it broke: EditTransaction.RemoveObject throws when obj.OnPingDocument() is not the edit's document. Only clear copies that check into its validation (GhDocumentTool.cs, the orphans pre-check). delete and group_delete have no such check. Before this branch, delete removed such an object through ToolHelpers.GetOwnerDocument's fallback (now deleted). Now one orphan id in a delete of N throws inside the edit and rolls back all N, with the error 'gh_canvas delete failed: \u2026 is not in the document this edit changes'. That breaks the per-id contract the ActionInfo tip promises, where an id refused at validation is reported and the rest proceed. Fix: expose the precondition once, for example a static EditTransaction.CanRemove(doc, obj) or a ToolHelpers predicate that RemoveObject itself also uses. Then make every removal's pass 1 call it: delete reports a per-id refusal, group_delete refuses up front, and clear uses it in place of its inline ReferenceEquals check. That leaves the throw as a guard nothing reaches. To find every caller, search for tx.RemoveObject.", "files": ["src/Cordyceps/Core/Edits/EditTransaction.cs", "src/Cordyceps/Tools/Unified/GhCanvasTool.cs", "src/Cordyceps/Tools/Unified/GhCanvasTool.Groups.cs", "src/Cordyceps/Tools/Unified/GhDocumentTool.cs"], "fid": "R-5"}, {"goal": "The Design Is Sound", "severity": "warning", "title": "SliderConfigPlan.ValueInvalid is now read only by tests, alongside Error: the flag that let 'add' miss the overflow is still public", "recommendation": "Scope: instance. Why it broke: Error replaced ValueInvalid as the refusal signal, but ValueInvalid was kept, with a private setter set only through Refused(..., valueInvalid: true). Production code no longer reads it; only SliderConfigTests does. Before this branch, 'add' checked exactly this flag and so missed the decimal-overflow and range refusals that Plan now reports through Error. A third slider caller would see the same flag and repeat that bug. Fix: delete ValueInvalid and its Refused parameter, and have the two tests that read it assert on plan.Error instead (the 'Invalid number: \u2026' text for an unparseable value, and Error being null or the overflow message for the out-of-range case). Error stays the plan's one refusal signal.", "files": ["src/Cordyceps/Core/SliderConfig.cs", "src/Cordyceps.Tests/SliderConfigTests.cs"], "fid": "R-6"}], "counts": {"blocking": 1, "warning": 5, "note": 0}, "observations": [{"goal": "The Design Is Sound", "title": "RebuildUnchanged repeats the commit's expire, schedule and solve-refusal reporting outside the edit layer", "recommendation": "Scope: instance. GhScriptTool.RebuildUnchanged calls ExpireSolution(false) and SolveCoordinator.Schedule itself, and copies scheduling.ToField() into 'solve' itself. That makes a second producer of the edit reply's 'solve' field, which bypasses EditReplies.CommitSolve and the journal's convention of catching a failed schedule and reporting it as a warning (here a schedule that throws reaches the tool boundary). It is correct today. If the solve-reporting rule changes in EditReplies.CommitSolve, this path will not follow. Consider having the no-op rebuild report its solve through the same EditReplies helper.", "files": ["src/Cordyceps/Tools/Unified/GhScriptTool.cs"], "oid": "O-1"}, {"goal": "Everything Is Coherent", "title": "CommonErrorsGuide calls the group member arrays and gh_document clear 'per-id', which contradicts MembersTip", "recommendation": "Scope: instance. The 'Edits, Undo and Rollback' section says per-id actions include 'the group member arrays' and 'gh_document clear', and that an id refused at validation is reported while the rest form one undo step. In the code, a group member array refuses the whole call when any entry fails to resolve: TryResolveIdArray, as MembersTip says ('If any entry does not resolve, the call fails naming it and nothing is changed'). clear takes no ids at all. The list was copied from the plan's Inference 1. Fix: delete those two items from the guide's list so it matches the gh_canvas general tip (delete, move, preview, enable, plus bulk connect).", "files": ["src/Cordyceps/Knowledge/CommonErrorsGuide.md"], "oid": "O-2"}], "duration_seconds": 960, "scope": "edit-transaction", "scope_chosen_by": "binding", "scope_unresolved_cause": null, "scope_reason": null, "base_extended_from": null, "chunks": [], "chunks_proposed": [], "chunk": null, "base_reviewed": "a3c4e1773abe2f46193198e0aa59816ca5e18cc9", "record_lint": {"records": [".prawduct/artifacts/build-plan-edit-transaction.md", ".prawduct/changes/edit-transaction.md", ".prawduct/operator-verification.md", ".prawduct/owner-rulings.md", "CHANGELOG.md", "CLAUDE.md", "README.md", "docs/architecture.md", "src/Cordyceps/Knowledge/CommonErrorsGuide.md", "src/Cordyceps/Knowledge/GettingStartedGuide.md"], "chunk_graded": null, "chunks_graded": [], "plan_graded": null, "findings": [], "unchecked": [], "counts": {"chunk-ref-missing": null, "governed-by-gap": 0, "suite-total-claim": 0, "learnings-over-budget": 0, "learnings-budget-unreasoned": 0, "learnings-core-raise-unapproved": 0, "learnings-rule-too-long": 0, "learnings-rule-body": 0, "learnings-area-dead": 0, "change-fragment": 0, "retired-claim-survives": 0}}, "dispatched_at": "2026-11-11T19:35:33Z"}}

